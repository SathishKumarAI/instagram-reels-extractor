# generated by `reels-scrap models pull deepseek-ocr` — do not edit by hand
# specialist control: An OCR specialist rather than a generalist VLM. Expected to win on on-screen text and lose on summarising — which is exactly the contrast.
FROM deepseek-ocr:3b
# six 720px frames + prompt overflow the stock 4096 context
PARAMETER num_ctx 32768
