# generated by `reels-scrap models pull minicpm-v45` — do not edit by hand
# different family, OCR-strong: Our reels are text-heavy screenshots. This family is built for reading on-screen text, so it tests whether OCR strength — not size — is the gap.
FROM minicpm-v4.5:8b
# six 720px frames + prompt overflow the stock 4096 context
PARAMETER num_ctx 32768
